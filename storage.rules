rules_version = '2';

// Write access is server-side only (Admin SDK bypasses these rules).
// Campaign documents are publicly readable so permanent public URLs work.
service firebase.storage {
  match /b/{bucket}/o {
    match /campaigns/{campaignId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
